# ---------------------------------------------------------------------------
# Shora Group — PRODUCTION environment.
#
# Rename this file to  .env  on the server (keep it OUTSIDE public/).
# Fill in every <PLACEHOLDER> before the site goes live.
# ---------------------------------------------------------------------------

APP_NAME="Shora Group"
APP_ENV=production
APP_KEY=base64:K54SW1j8PETsiOGKmiA6378ZMnA3Kk/3T83XQApn15Q=
APP_DEBUG=false
APP_URL=https://<YOUR-DOMAIN>

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Only warnings and above, so the log file does not grow without bound.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# From the hosting control panel (cPanel usually prefixes the names).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<DB_NAME>
DB_USERNAME=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies over HTTPS only — enable once the SSL certificate is active.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting has no queue worker running, so jobs run inline.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Real SMTP credentials — contact-form and job-application mail is sent here.
MAIL_MAILER=smtp
MAIL_HOST=<SMTP_HOST>
MAIL_PORT=587
MAIL_USERNAME=<SMTP_USER>
MAIL_PASSWORD=<SMTP_PASSWORD>
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="<noreply@your-domain.com>"
MAIL_FROM_NAME="${APP_NAME}"

# Secret for public/deploy-setup.php. Delete this line together with that file.
DEPLOY_TOKEN=fdf911766d36b95455b8cdd4129b848aae353a34eeaf7990
